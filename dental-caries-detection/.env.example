# Copy to .env before running:  cp .env.example .env
# Comments are kept on their own lines on purpose: `docker run --env-file`
# does not strip inline comments, so `KEY=value  # note` would break there.

# --- Database ---
POSTGRES_USER=caries
POSTGRES_PASSWORD=caries_dev_pw
POSTGRES_DB=status_db
DATABASE_URL=postgresql://caries:caries_dev_pw@db:5432/status_db
# Host-side port for PostgreSQL (bound to 127.0.0.1). Change it if 5432 is
# already taken by a local PostgreSQL install.
POSTGRES_HOST_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
MAX_IMAGE_MB=25
MIN_IMAGE_WIDTH=1000
MIN_IMAGE_HEIGHT=500
SHARED_DIR=/shared
POLL_INTERVAL_MS=2000
# Browser origin allowed by CORS (the frontend's URL, not the backend's).
CORS_ORIGIN=http://localhost:3000

# --- ML driver (Phase 1) ---
# mock | http
ML_DRIVER=mock
# Unused in Phase 1, kept for Phase 2
ML_SERVICE_URL=http://ml-service:8001
# Simulated inference time in milliseconds
MOCK_ML_DELAY_MS=6000
# 0..1, probability that a mock run ends in `fail`
MOCK_ML_FAILURE_RATE=0

# --- Frontend ---
FRONTEND_PORT=3000
FRONTEND_API_BASE_URL=http://localhost:8000
VITE_POLL_INTERVAL_MS=2000
# Client-side pre-flight validation mirror of MAX_IMAGE_MB / MIN_IMAGE_WIDTH /
# MIN_IMAGE_HEIGHT above (BE-3.1); the backend remains authoritative.
VITE_MAX_IMAGE_MB=25
VITE_MIN_IMAGE_WIDTH=1000
VITE_MIN_IMAGE_HEIGHT=500
# enabled | disabled. Only takes effect in `npm run dev` (import.meta.env.DEV);
# a production build/preview never mocks. Lets FE build Sprints 4-6 against a
# simulated backend before ML_DRIVER=mock's real HTTP routes exist (BE-3.x).
VITE_API_MOCKING=enabled
# Mirrors backend's MOCK_ML_DELAY_MS / MOCK_ML_FAILURE_RATE above, but for the
# frontend-side MSW mock (src/mocks/handlers.ts), not the real backend.
VITE_MOCK_ML_DELAY_MS=4000
VITE_MOCK_ML_FAILURE_RATE=0

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=dev@example.com
PGADMIN_DEFAULT_PASSWORD=admin
